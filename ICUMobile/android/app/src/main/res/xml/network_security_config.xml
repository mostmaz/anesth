<?xml version="1.0" encoding="utf-8"?>
<!--
  The backend is HTTPS, so plain HTTP is blocked everywhere except the local
  development hosts below (Metro bundler, or a backend running on this machine
  and reached from the emulator). Patient data never travels unencrypted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
